   "cues": [
    0.0,
    4.468,
    8.697,
    13.245
   ],
   "lines": [
    {
     "text": "Cast a vote in the arena, rate the answers that you read",
     "start": 128.856,
     "end": 133.324
    },
    {
     "text": "Write the tests in your own language, show it what your people need",
     "start": 133.324,
     "end": 137.553
    },
    {
     "text": "Translate, review and argue, bring your values to the frame",
     "start": 137.553,
     "end": 142.101
    },
    {
     "text": "Alignment's not a finish line, it's a game we play the same",
     "start": 142.101,
     "end": 147.287
    }
