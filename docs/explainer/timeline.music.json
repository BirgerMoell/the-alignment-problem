  {
   "id": "m_verse1",
   "chapter": "Verse 1",
   "variant": 1,
   "start": 11.649,
   "dur": 17.234,
   "cues": [
    0.0,
    4.468,
    8.378,
    12.925
   ],
   "lines": [
    {
     "text": "It read the whole wide internet, the gentle and the cruel",
     "start": 11.649,
     "end": 16.117
    },
    {
     "text": "It learned to finish anything, but no one wrote the rules",
     "start": 16.117,
     "end": 20.027
    },
    {
     "text": "So we lay two answers side by side and ask you which is best",
     "start": 20.027,
     "end": 24.574
    },
    {
     "text": "A million little choices, and the model learns the rest",
     "start": 24.574,
     "end": 28.883
    }
   ]
  },
  {
   "id": "m_pre",
   "chapter": "Pre-Chorus",
   "variant": 1,
   "start": 28.883,
   "dur": 9.335,
   "cues": [
    0.0,
    4.787
   ],
   "lines": [
    {
     "text": "Thumbs up, thumbs down, a quiet signal grows",
     "start": 28.883,
     "end": 33.67
    },
    {
     "text": "Chosen and rejected, that's how a model knows",
     "start": 33.67,
     "end": 38.218
    }
   ]
  },
  {
